{
  "name": "@represt/mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
