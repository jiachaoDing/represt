    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.12.2",
    "fflate": "^0.8.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
