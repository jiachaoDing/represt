{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "represt": {
      "type": "streamable-http",
      "url": "https://share.represt.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://share.represt.app/mcp",
            "baseScopes": ["training:read"],
            "defaultScopes": ["training:read", "plans:write", "offline_access"]
          }
        }
      }
    }
  }
}
