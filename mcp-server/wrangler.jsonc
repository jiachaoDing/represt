{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "represt-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "observability": { "enabled": true },
  "services": [{ "binding": "REPREST_API", "service": "represt-worker" }],
  "vars": {
    "MCP_PUBLIC_URL": "https://share.represt.app/mcp",
    "REPREST_API_BASE_URL": "https://share.represt.app",
    "MCP_ALLOWED_ORIGINS": "https://chatgpt.com,https://claude.ai"
  }
}
